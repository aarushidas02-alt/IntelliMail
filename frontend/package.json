{
  "main": "electron.js",
  "name": "frontend",
  "version": "0.1.0",
  "private": true,

  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },

  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },

  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },

  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],

    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },

  "build": {
    "extends": null,

    "appId": "com.intellimail.app",
    "productName": "IntelliMail",

    "files": [
      "build/**/*",
      "electron.js",
      "assets/**/*",
      "node_modules/**/*"
    ],

    "directories": {
      "buildResources": "assets"
    },

    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },

    "win": {
      "target": "nsis",
      "icon": "assets/intellimail.png"
    }
  },

  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}